{
  "name": "pi-seamless-copy",
  "version": "0.1.0",
  "description": "Copy text from Pi's fullscreen TUI without the line breaks that terminal-width wrapping added.",
  "type": "module",
  "license": "MIT",
  "author": "yikZero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yikZero/pi-seamless-copy.git"
  },
  "homepage": "https://github.com/yikZero/pi-seamless-copy#readme",
  "bugs": "https://github.com/yikZero/pi-seamless-copy/issues",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "copy",
    "clipboard",
    "soft-wrap",
    "cjk"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:e2e": "uv run --with pyte==0.8.2 python scripts/e2e.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.18"
  }
}
